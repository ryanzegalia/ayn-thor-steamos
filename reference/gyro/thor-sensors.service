[Unit]
Description=Thor motion sensors: hexagonrpcd serves the ADSP sensors process (gyro)
# Must attach early in boot: attaching long after boot never brought the
# sensor hub's QMI service up (2026-10-19). The sound card binds first
# (audio shares the ADSP); thor-sensors prepare waits for it.
ConditionPathExists=/dev/fastrpc-adsp
After=sound.target systemd-udevd.service
Wants=thor-motiond.service

[Service]
Type=simple
ExecCondition=/usr/lib/thor-sensors/thor-sensors check
ExecStart=/usr/lib/thor-sensors/thor-sensors run
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
