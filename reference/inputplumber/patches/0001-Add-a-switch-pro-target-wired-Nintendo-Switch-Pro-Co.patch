+//! Nintendo Switch Pro Controller (USB) protocol constants, for the
+//! `switch-pro` target device. References: dekuNukem
+//! Nintendo_Switch_Reverse_Engineering (bluetooth_hid_notes.md,
+//! bluetooth_hid_subcommands_notes.md, spi_flash_notes.md, USB-HID-Notes.md),
+//! Linux drivers/hid/hid-nintendo.c and SDL's SDL_hidapi_switch.c (the host
+//! side Steam and the kernel run against this device).
+pub mod report_descriptor;
+
+pub const VID: u16 = 0x057e;
+pub const PID: u16 = 0x2009;
+
+/// Every input and output report is 64 bytes including the report id.
+pub const REPORT_SIZE: usize = 64;
+
+// Input report ids (device -> host)
+pub const INPUT_SUBCMD_REPLY: u8 = 0x21;
+pub const INPUT_STANDARD_FULL: u8 = 0x30;
+pub const INPUT_USB_REPLY: u8 = 0x81;
+
+// Output report ids (host -> device)
+pub const OUTPUT_RUMBLE_AND_SUBCMD: u8 = 0x01;
+pub const OUTPUT_RUMBLE_ONLY: u8 = 0x10;
+pub const OUTPUT_USB_CMD: u8 = 0x80;
+
+// USB commands (output report 0x80, byte 1)
+pub const USB_CMD_STATUS: u8 = 0x01;
+pub const USB_CMD_HANDSHAKE: u8 = 0x02;
+pub const USB_CMD_BAUDRATE_3M: u8 = 0x03;
+pub const USB_CMD_NO_TIMEOUT: u8 = 0x04;
+pub const USB_CMD_ALLOW_TIMEOUT: u8 = 0x05;
+
+// Subcommands (output report 0x01, byte 10)
+pub const SUBCMD_DEVICE_INFO: u8 = 0x02;
+pub const SUBCMD_SET_INPUT_MODE: u8 = 0x03;
+pub const SUBCMD_TRIGGER_ELAPSED: u8 = 0x04;
+pub const SUBCMD_SPI_READ: u8 = 0x10;
+pub const SUBCMD_SPI_WRITE: u8 = 0x11;
+pub const SUBCMD_SPI_ERASE: u8 = 0x12;
+pub const SUBCMD_SET_PLAYER_LIGHTS: u8 = 0x30;
+pub const SUBCMD_GET_PLAYER_LIGHTS: u8 = 0x31;
+pub const SUBCMD_SET_HOME_LIGHT: u8 = 0x38;
+pub const SUBCMD_ENABLE_IMU: u8 = 0x40;
+pub const SUBCMD_ENABLE_VIBRATION: u8 = 0x48;
+pub const SUBCMD_GET_REGULATED_VOLTAGE: u8 = 0x50;
+
+/// Device type byte in the USB status reply and the device info reply.
+pub const CONTROLLER_TYPE_PRO: u8 = 0x03;
+
+/// High nibble: battery full (8), not charging. Low nibble: Pro Controller
+/// (connection bits 0), powered by the host (bit 0).
+pub const BATTERY_CONNECTION: u8 = 0x81;
+
+/// Byte 12 of every input report ("vibrator input report"); hosts ignore it.
+pub const VIBRATOR_REPORT: u8 = 0x80;
+
+/// Most bytes one SPI read reply carries.
+pub const SPI_READ_MAX: usize = 0x1d;
+
+/// 12-bit stick axes: the centre and the deflection the factory calibration
+/// below declares, so the host maps -1.0..1.0 onto the full stick range.
+pub const STICK_CENTER: u16 = 0x800;
+pub const STICK_RANGE: u16 = 0x640;
+
+/// 1 G in raw accelerometer units (+-8 G range, sensitivity 0x4000).
+pub const ACCEL_1G: f64 = 4096.0;
+/// Raw gyro units per degree per second (+-2000 dps range, 0.07 dps/LSB).
+pub const GYRO_PER_DPS: f64 = 1.0 / 0.07;
+
+/// Two 12-bit values packed into 3 bytes, the layout of the stick axes in the
+/// input reports and of the stick calibration in SPI flash.
+pub fn pack_12bit_pair(a: u16, b: u16) -> [u8; 3] {
+    [
+        (a & 0xff) as u8,
+        ((a >> 8) & 0x0f) as u8 | (((b & 0x0f) as u8) << 4),
+        ((b >> 4) & 0xff) as u8,
+    ]
+}
+
+/// Byte at `addr` of the controller's SPI flash, as a factory-fresh Pro
+/// Controller with no user calibration reports it. Unlisted addresses read
+/// 0xff (erased flash), which also means "no user calibration" at 0x8010+.
+pub fn spi_flash_byte(addr: u32) -> u8 {
+    // 0x6012: device type
+    if addr == 0x6012 {
+        return CONTROLLER_TYPE_PRO;
+    }
+    // 0x601b: colours are stored in SPI (0x01)
+    if addr == 0x601b {
+        return 0x01;
+    }
+    // 0x6020..0x6038: factory IMU calibration: accel origin (0,0,0), accel
+    // sensitivity 0x4000 x3, gyro origin (0,0,0), gyro sensitivity 0x343b x3
+    if (0x6020..0x6038).contains(&addr) {
+        const IMU: [u8; 24] = [
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, //
+            0x00, 0x40, 0x00, 0x40, 0x00, 0x40, //
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, //
+            0x3b, 0x34, 0x3b, 0x34, 0x3b, 0x34,
+        ];
+        return IMU[(addr - 0x6020) as usize];
+    }
+    // 0x603d..0x604f: factory stick calibration. Left stick: max above
+    // centre, centre, min below centre. Right stick: centre, min below, max
+    // above (the right stick's order differs on purpose).
+    if (0x603d..0x604f).contains(&addr) {
+        let range = pack_12bit_pair(STICK_RANGE, STICK_RANGE);
+        let center = pack_12bit_pair(STICK_CENTER, STICK_CENTER);
+        let mut cal = [0u8; 18];
+        cal[0..3].copy_from_slice(&range);
+        cal[3..6].copy_from_slice(&center);
+        cal[6..9].copy_from_slice(&range);
+        cal[9..12].copy_from_slice(&center);
+        cal[12..15].copy_from_slice(&range);
+        cal[15..18].copy_from_slice(&range);
+        return cal[(addr - 0x603d) as usize];
+    }
+    // 0x6050..0x605c: body, buttons, left grip, right grip colours (RGB)
+    if (0x6050..0x605c).contains(&addr) {
+        const COLORS: [u8; 12] = [
+            0x32, 0x32, 0x32, // body: dark grey
+            0xff, 0xff, 0xff, // buttons: white
+            0x1e, 0x1e, 0x1e, // left grip
+            0x1e, 0x1e, 0x1e, // right grip
+        ];
+        return COLORS[(addr - 0x6050) as usize];
+    }
+    // 0x6080..0x6086: six-axis horizontal offsets of a Pro Controller
+    if (0x6080..0x6086).contains(&addr) {
+        const OFFSETS: [u8; 6] = [0x50, 0xfd, 0x00, 0x00, 0xc6, 0x0f];
+        return OFFSETS[(addr - 0x6080) as usize];
+    }
+    // 0x6086..0x6098 and 0x6098..0x60aa: left and right stick parameters
+    // (dead zone, range ratio), as factory Pro Controllers ship them
+    if (0x6086..0x60aa).contains(&addr) {
+        const PARAMS: [u8; 18] = [
+            0x0f, 0x30, 0x61, 0x96, 0x30, 0xf3, 0xd4, 0x14, 0x54, //
+            0x41, 0x15, 0x54, 0xc7, 0x79, 0x9c, 0x33, 0x36, 0x63,
+        ];
+        return PARAMS[((addr - 0x6086) % 18) as usize];
+    }
+    0xff
+}
+
+/// Rumble amplitude in thousandths for an encoded amplitude index (0-100),
+/// following the shape of hid-nintendo's joycon_rumble_amplitudes table
+/// (index 1 = 10, index 16 = 117, index 100 = 1003).
+pub fn rumble_amplitude_permille(index: u16) -> f64 {
+    match index {
+        0 => 0.0,
+        1..=15 => 10.0 * (112.0f64 / 10.0).powf((index - 1) as f64 / 14.0),
+        _ => 117.0 * (1003.0f64 / 117.0).powf((index.min(100) - 16) as f64 / 84.0),
+    }
+}
+
+/// (high band, low band) amplitude indexes of one actuator's 4 rumble bytes.
+/// High band: byte 1 bits 1-7. Low band: byte 3 minus 0x40, doubled, plus
+/// byte 2 bit 7. Neutral rumble (00 01 40 40) decodes to (0, 0).
+pub fn decode_rumble(side: &[u8]) -> (u16, u16) {
+    if side.len() < 4 {
+        return (0, 0);
+    }
+    let high = (side[1] >> 1) as u16;
+    let low = if side[3] >= 0x40 {
+        (side[3] - 0x40) as u16 * 2 + (side[2] >> 7) as u16
+    } else {
+        0
+    };
+    (high.min(100), low.min(100))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn packs_stick_axes() {
+        // centre 0x800 both axes
+        assert_eq!(pack_12bit_pair(0x800, 0x800), [0x00, 0x08, 0x80]);
+        assert_eq!(pack_12bit_pair(0x640, 0x640), [0x40, 0x06, 0x64]);
+        assert_eq!(pack_12bit_pair(0xfff, 0x000), [0xff, 0x0f, 0x00]);
+        assert_eq!(pack_12bit_pair(0x000, 0xfff), [0x00, 0xf0, 0xff]);
+    }
+
+    #[test]
+    fn spi_has_calibration() {
+        // left stick factory cal: range, centre, range
+        let left: Vec<u8> = (0x603d..0x6046).map(spi_flash_byte).collect();
+        assert_eq!(left, [0x40, 0x06, 0x64, 0x00, 0x08, 0x80, 0x40, 0x06, 0x64]);
+        // right stick factory cal: centre, range, range
+        let right: Vec<u8> = (0x6046..0x604f).map(spi_flash_byte).collect();
+        assert_eq!(right, [0x00, 0x08, 0x80, 0x40, 0x06, 0x64, 0x40, 0x06, 0x64]);
+        // no user calibration
+        assert_eq!(spi_flash_byte(0x8010), 0xff);
+        assert_eq!(spi_flash_byte(0x6012), CONTROLLER_TYPE_PRO);
+    }
+
+    #[test]
+    fn decodes_rumble() {
+        assert_eq!(decode_rumble(&[0x00, 0x01, 0x40, 0x40]), (0, 0));
+        // index 1 low band = 0x8040, index 100 high band = 0xc8
+        assert_eq!(decode_rumble(&[0x74, 0xc8, 0xbd, 0x40]), (100, 1));
+        assert_eq!(decode_rumble(&[0x74, 0x00, 0x3d, 0x72]), (0, 100));
+        assert_eq!(rumble_amplitude_permille(0), 0.0);
+        assert!((rumble_amplitude_permille(100) - 1003.0).abs() < 0.5);
+        assert!((rumble_amplitude_permille(16) - 117.0).abs() < 0.5);
+    }
+}
