+impl TargetOutputDevice for SwitchProDevice {
+    /// Answer whatever the hosts sent since the last poll, then stream the
+    /// full input report.
+    /// https://www.kernel.org/doc/html/latest/hid/uhid.html#read
+    fn poll(&mut self, _: &Option<CompositeDeviceClient>) -> Result<Vec<OutputEvent>, OutputError> {
+        let mut output_events = vec![];
+        for _ in 0..MAX_EVENTS_PER_POLL {
+            let event = match self.device.read() {
+                Ok(event) => event,
+                Err(StreamError::Io(e)) => {
+                    if e.kind() != ErrorKind::WouldBlock {
+                        log::debug!("Error reading from UHID device: {e:?}");
+                    }
+                    break;
+                }
+                Err(StreamError::UnknownEventType(e)) => {
+                    log::debug!("Unknown event type: {:?}", e);
+                    continue;
+                }
+            };
+
+            match event {
+                uhid_virt::OutputEvent::Start { dev_flags: _ } => {
+                    log::debug!("Start event received");
+                }
+                uhid_virt::OutputEvent::Stop => {
+                    log::debug!("Stop event received");
+                }
+                uhid_virt::OutputEvent::Open => {
+                    log::debug!("Open event received");
+                }
+                uhid_virt::OutputEvent::Close => {
+                    log::debug!("Close event received");
+                }
+                uhid_virt::OutputEvent::Output { data } => {
+                    log::trace!("Got output data: {:02x?}", data);
+                    output_events.extend(self.handle_output(&data));
+                }
+                // Not part of the Pro Controller protocol: answer at once so
+                // a probing host does not wait for the uhid timeout.
+                uhid_virt::OutputEvent::GetReport {
+                    id, report_number, ..
+                } => {
+                    log::debug!("Received GetReport: id: {id}, report_number: {report_number}");
+                    if let Err(e) = self.device.write_get_report_reply(id, 1, vec![]) {
+                        log::warn!("Failed to write get report reply: {:?}", e);
+                    }
+                }
+                uhid_virt::OutputEvent::SetReport {
+                    id, report_number, ..
+                } => {
+                    log::debug!("Received SetReport: id: {id}, report_number: {report_number}");
+                    if let Err(e) = self.device.write_set_report_reply(id, 0) {
+                        log::warn!("Failed to write set report reply: {:?}", e);
+                    }
+                }
+            }
+        }
+
+        // Replies first, in order, then the periodic full report
+        while let Some(reply) = self.replies.pop_front() {
+            self.write_report(&reply);
+        }
+        if self.streaming && self.last_report.elapsed() >= REPORT_INTERVAL {
+            let report = self.full_report();
+            self.write_report(&report);
+            self.last_report = Instant::now();
+        }
+
+        Ok(output_events)
+    }
+
+    fn get_output_capabilities(&self) -> Result<Vec<OutputCapability>, OutputError> {
+        Ok(vec![OutputCapability::ForceFeedback])
+    }
+}
