+/// A normalized stick value (-1.0 to 1.0) as a 12-bit Pro Controller axis.
+fn stick_value(value: f64) -> u16 {
+    let value = value.clamp(-1.0, 1.0);
+    (STICK_CENTER as f64 + value * STICK_RANGE as f64)
+        .round()
+        .clamp(0.0, 4095.0) as u16
+}
+
+/// Digital trigger state from an analog value, with hysteresis.
+fn trigger_pressed(was_pressed: bool, value: f64) -> bool {
+    if was_pressed {
+        value >= TRIGGER_RELEASE
+    } else {
+        value >= TRIGGER_PRESS
+    }
+}
+
+fn clamp_i16(value: f64) -> i16 {
+    value.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16
+}
+
+/// A stable MAC address for this machine (Steam keeps per-controller
+/// settings by it): Nintendo's OUI plus three bytes of /etc/machine-id.
+fn device_mac() -> [u8; 6] {
+    let id = std::fs::read_to_string("/etc/machine-id").unwrap_or_default();
+    // FNV-1a
+    let mut hash: u32 = 0x811c9dc5;
+    for byte in id.trim().bytes() {
+        hash ^= byte as u32;
+        hash = hash.wrapping_mul(0x01000193);
+    }
+    let h = hash.to_be_bytes();
+    [0x98, 0xb6, 0xe9, h[1], h[2], h[3]]
+}
