diff --git a/src/input/target/switch_pro.rs b/src/input/target/switch_pro.rs
new file mode 100644
index 0000000..b8f11b3
--- /dev/null
+++ b/src/input/target/switch_pro.rs
@@ -0,0 +1,790 @@
+//! Emulates a wired Nintendo Switch Pro Controller as a target input device
+//! using uhid, so Steam and games that read the controller type show
+//! Nintendo button glyphs.
+//!
+//! A Pro Controller only reports input after a host sets it up, so this target
+//! answers the host side of the protocol: the USB 0x80 commands, the 0x01
+//! subcommands (device info, SPI flash reads with the stick and IMU
+//! calibration, input mode, IMU, vibration, lights), and then streams the
+//! 0x30 full input report. Two hosts run that setup against it: Steam (its
+//! Switch driver, the same one as SDL_hidapi_switch.c) and the kernel's
+//! hid-nintendo driver, which binds to any USB 057e:2009 device. hid-nintendo
+//! then adds its own "Nintendo Switch Pro Controller" event devices; InputPlumber
+//! skips them as virtual, and Steam tells the games it launches to ignore them.
+//!
+//! Face buttons map by label: InputPlumber's South/East/West/North are the
+//! Xbox A/B/X/Y, and a Pro Controller's A/B/X/Y carry the same letters. On a
+//! handheld whose capability map sends the printed Nintendo letters (the AYN
+//! Thor's ayn_mcu_nintendo: printed A on the right = South), each printed
+//! button lands on the Pro Controller button in the same place.
+use std::{
+    collections::{HashMap, VecDeque},
+    error::Error,
+    fmt::Debug,
+    fs::File,
+    io::ErrorKind,
+    time::{Duration, Instant},
+};
+
+use uhid_virt::{Bus, CreateParams, StreamError, UHIDDevice};
+
+use crate::{
+    drivers::switch_pro::{
+        decode_rumble, pack_12bit_pair, report_descriptor::REPORT_DESCRIPTOR,
+        rumble_amplitude_permille, spi_flash_byte, ACCEL_1G, BATTERY_CONNECTION,
+        CONTROLLER_TYPE_PRO, GYRO_PER_DPS, INPUT_STANDARD_FULL, INPUT_SUBCMD_REPLY,
+        INPUT_USB_REPLY, OUTPUT_RUMBLE_AND_SUBCMD, OUTPUT_RUMBLE_ONLY, OUTPUT_USB_CMD, PID,
+        REPORT_SIZE, SPI_READ_MAX, STICK_CENTER, STICK_RANGE, SUBCMD_DEVICE_INFO,
+        SUBCMD_ENABLE_IMU, SUBCMD_GET_PLAYER_LIGHTS, SUBCMD_GET_REGULATED_VOLTAGE,
+        SUBCMD_SET_INPUT_MODE, SUBCMD_SET_PLAYER_LIGHTS, SUBCMD_SPI_ERASE, SUBCMD_SPI_READ,
+        SUBCMD_SPI_WRITE, SUBCMD_TRIGGER_ELAPSED, USB_CMD_ALLOW_TIMEOUT, USB_CMD_BAUDRATE_3M,
+        USB_CMD_HANDSHAKE, USB_CMD_NO_TIMEOUT, USB_CMD_STATUS, VIBRATOR_REPORT, VID,
+    },
+    input::{
+        capability::{Capability, Gamepad, GamepadAxis, GamepadButton, GamepadTrigger},
+        composite_device::client::CompositeDeviceClient,
+        event::{
+            native::{NativeEvent, ScheduledNativeEvent},
+            value::InputValue,
+        },
+        output_capability::OutputCapability,
+        output_event::OutputEvent,
+    },
+};
+
+use super::{InputError, OutputError, TargetInputDevice, TargetOutputDevice};
+
+/// The minimum interval between button events must wait between
+/// each other for chords.
+const MIN_CHORD_TIME: Duration = Duration::from_millis(80);
+
+/// Full input reports go out at most this often (a wired Pro Controller
+/// streams every 8 ms; twice that rate keeps input latency down).
+const REPORT_INTERVAL: Duration = Duration::from_millis(4);
+
+/// Most uhid events handled in one poll, so a burst cannot starve input.
+const MAX_EVENTS_PER_POLL: usize = 32;
+
+/// An analog trigger counts as pressed above this and released below the
+/// lower value (a Pro Controller's ZL/ZR are digital).
+const TRIGGER_PRESS: f64 = 0.30;
+const TRIGGER_RELEASE: f64 = 0.20;
+
+/// Firmware version reported in the device info reply (4.33, a shipping
+/// Pro Controller firmware).
+const FIRMWARE_VERSION: [u8; 2] = [0x04, 0x33];
+
+/// Controller state, in Pro Controller terms.
+#[derive(Debug, Clone, Copy)]
+struct ControllerState {
+    a: bool,
+    b: bool,
+    x: bool,
+    y: bool,
+    l: bool,
+    r: bool,
+    zl_button: bool,
+    zr_button: bool,
+    zl_analog: bool,
+    zr_analog: bool,
+    minus: bool,
+    plus: bool,
+    home: bool,
+    capture: bool,
+    l_stick: bool,
+    r_stick: bool,
+    up: bool,
+    down: bool,
+    left: bool,
+    right: bool,
+    left_stick: (u16, u16),
+    right_stick: (u16, u16),
+    accel: [i16; 3],
+    gyro: [i16; 3],
+}
+
+impl Default for ControllerState {
+    fn default() -> Self {
+        Self {
+            a: false,
+            b: false,
+            x: false,
+            y: false,
+            l: false,
+            r: false,
+            zl_button: false,
+            zr_button: false,
+            zl_analog: false,
+            zr_analog: false,
+            minus: false,
+            plus: false,
+            home: false,
+            capture: false,
+            l_stick: false,
+            r_stick: false,
+            up: false,
+            down: false,
+            left: false,
+            right: false,
+            left_stick: (STICK_CENTER, STICK_CENTER),
+            right_stick: (STICK_CENTER, STICK_CENTER),
+            // Lying flat: gravity on Z
+            accel: [0, 0, ACCEL_1G as i16],
+            gyro: [0, 0, 0],
+        }
+    }
+}
+
+impl ControllerState {
+    /// The three button bytes of an input report (right, shared, left).
+    fn buttons(&self) -> [u8; 3] {
+        let zr = self.zr_button || self.zr_analog;
+        let zl = self.zl_button || self.zl_analog;
+        let right = self.y as u8
+            | (self.x as u8) << 1
+            | (self.b as u8) << 2
+            | (self.a as u8) << 3
+            | (self.r as u8) << 6
+            | (zr as u8) << 7;
+        let shared = self.minus as u8
+            | (self.plus as u8) << 1
+            | (self.r_stick as u8) << 2
+            | (self.l_stick as u8) << 3
+            | (self.home as u8) << 4
+            | (self.capture as u8) << 5;
+        let left = self.down as u8
+            | (self.up as u8) << 1
+            | (self.right as u8) << 2
+            | (self.left as u8) << 3
+            | (self.l as u8) << 6
+            | (zl as u8) << 7;
+        [right, shared, left]
+    }
+}
+
+/// The [SwitchProDevice] is a target input device implementation that emulates
+/// a wired Nintendo Switch Pro Controller using uhid.
+pub struct SwitchProDevice {
+    device: UHIDDevice<File>,
+    state: ControllerState,
+    timer: u8,
+    mac: [u8; 6],
+    /// Full input reports flow once a host set the input mode or ended the
+    /// USB handshake, like a real controller.
+    streaming: bool,
+    imu_enabled: bool,
+    player_lights: u8,
+    replies: VecDeque<[u8; REPORT_SIZE]>,
+    /// SPI flash bytes a host wrote (user calibration), read back on request.
+    spi_writes: HashMap<u32, u8>,
+    /// Last rumble sent to the source devices: (weak, strong).
+    rumble: (u16, u16),
+    last_report: Instant,
+    write_errors: u64,
+    queued_events: Vec<ScheduledNativeEvent>,
+}
+
+impl SwitchProDevice {
+    pub fn new() -> Result<Self, Box<dyn Error>> {
+        let device = SwitchProDevice::create_virtual_device()?;
+        Ok(Self {
+            device,
+            state: ControllerState::default(),
+            timer: 0,
+            mac: device_mac(),
+            streaming: false,
+            imu_enabled: false,
+            player_lights: 0,
+            replies: VecDeque::new(),
+            spi_writes: HashMap::new(),
+            rumble: (0, 0),
+            last_report: Instant::now(),
+            write_errors: 0,
+            queued_events: Vec::new(),
+        })
+    }
+
+    /// Create the virtual device to emulate
+    fn create_virtual_device() -> Result<UHIDDevice<File>, Box<dyn Error>> {
+        let device = UHIDDevice::create(CreateParams {
+            name: String::from("Nintendo Co., Ltd. Pro Controller"),
+            phys: String::from(""),
+            uniq: String::from(""),
+            bus: Bus::USB,
+            vendor: VID as u32,
+            product: PID as u32,
+            version: 0x0200,
+            country: 0,
+            rd_data: REPORT_DESCRIPTOR.to_vec(),
+        })?;
+
+        Ok(device)
+    }
+
+    /// Write one input report; a failure is logged, never fatal (a poll
+    /// error would stop the target).
+    fn write_report(&mut self, report: &[u8; REPORT_SIZE]) {
+        if let Err(e) = self.device.write(report) {
+            self.write_errors += 1;
+            if self.write_errors == 1 || self.write_errors % 1000 == 0 {
+                log::warn!(
+                    "Failed to write Switch Pro report 0x{:02x} ({} failures): {e:?}",
+                    report[0],
+                    self.write_errors
+                );
+            }
+        }
+    }
+
+    /// Report id, timer, battery, buttons, sticks: the first 13 bytes every
+    /// input report shares.
+    fn base_report(&mut self, id: u8) -> [u8; REPORT_SIZE] {
+        let mut report = [0u8; REPORT_SIZE];
+        self.timer = self.timer.wrapping_add(1);
+        report[0] = id;
+        report[1] = self.timer;
+        report[2] = BATTERY_CONNECTION;
+        report[3..6].copy_from_slice(&self.state.buttons());
+        let (lx, ly) = self.state.left_stick;
+        let (rx, ry) = self.state.right_stick;
+        report[6..9].copy_from_slice(&pack_12bit_pair(lx, ly));
+        report[9..12].copy_from_slice(&pack_12bit_pair(rx, ry));
+        report[12] = VIBRATOR_REPORT;
+        report
+    }
+
+    /// The 0x30 standard full input report, with three IMU samples when the
+    /// host enabled the IMU.
+    fn full_report(&mut self) -> [u8; REPORT_SIZE] {
+        let mut report = self.base_report(INPUT_STANDARD_FULL);
+        if self.imu_enabled {
+            let mut sample = [0u8; 12];
+            for (i, value) in self.state.accel.iter().chain(self.state.gyro.iter()).enumerate() {
+                sample[i * 2..i * 2 + 2].copy_from_slice(&value.to_le_bytes());
+            }
+            for n in 0..3 {
+                report[13 + n * 12..25 + n * 12].copy_from_slice(&sample);
+            }
+        }
+        report
+    }
+
+    /// Queue a 0x21 subcommand reply.
+    fn reply_subcommand(&mut self, subcmd: u8, ack: u8, data: &[u8]) {
+        let mut report = self.base_report(INPUT_SUBCMD_REPLY);
+        report[13] = ack;
+        report[14] = subcmd;
+        let len = data.len().min(REPORT_SIZE - 15);
+        report[15..15 + len].copy_from_slice(&data[..len]);
+        self.replies.push_back(report);
+    }
+
+    /// Queue a 0x81 USB command reply.
+    fn reply_usb(&mut self, cmd: u8, data: &[u8]) {
+        let mut report = [0u8; REPORT_SIZE];
+        report[0] = INPUT_USB_REPLY;
+        report[1] = cmd;
+        let len = data.len().min(REPORT_SIZE - 2);
+        report[2..2 + len].copy_from_slice(&data[..len]);
+        self.replies.push_back(report);
+    }
+
+    /// Handle a USB command (output report 0x80).
+    fn handle_usb_command(&mut self, data: &[u8]) {
+        let Some(&cmd) = data.get(1) else {
+            return;
+        };
+        log::debug!("Switch Pro USB command 0x{cmd:02x}");
+        match cmd {
+            USB_CMD_STATUS => {
+                // 00, device type, MAC address little endian
+                let mut status = vec![0x00, CONTROLLER_TYPE_PRO];
+                status.extend(self.mac.iter().rev());
+                self.reply_usb(cmd, &status);
+            }
+            USB_CMD_HANDSHAKE | USB_CMD_BAUDRATE_3M => self.reply_usb(cmd, &[]),
+            // HID-only mode from now on: no reply, input starts flowing
+            USB_CMD_NO_TIMEOUT => self.streaming = true,
+            USB_CMD_ALLOW_TIMEOUT => (),
+            _ => log::debug!("Unhandled Switch Pro USB command 0x{cmd:02x}"),
+        }
+    }
+
+    /// Handle a subcommand (output report 0x01, byte 10; arguments from 11).
+    fn handle_subcommand(&mut self, data: &[u8]) {
+        let Some(&subcmd) = data.get(10) else {
+            return;
+        };
+        let args = data.get(11..).unwrap_or(&[]);
+        log::debug!("Switch Pro subcommand 0x{subcmd:02x} args {:02x?}", &args[..args.len().min(8)]);
+        match subcmd {
+            SUBCMD_DEVICE_INFO => {
+                // firmware, type, 02, MAC big endian, 01, 01 (colours in SPI)
+                let mut info = FIRMWARE_VERSION.to_vec();
+                info.extend([CONTROLLER_TYPE_PRO, 0x02]);
+                info.extend(self.mac);
+                info.extend([0x01, 0x01]);
+                self.reply_subcommand(subcmd, 0x82, &info);
+            }
+            SUBCMD_SET_INPUT_MODE => {
+                if let Some(&mode) = args.first() {
+                    log::debug!("Switch Pro input mode 0x{mode:02x}");
+                    if mode == INPUT_STANDARD_FULL || mode == 0x31 {
+                        self.streaming = true;
+                    }
+                }
+                self.reply_subcommand(subcmd, 0x80, &[]);
+            }
+            SUBCMD_TRIGGER_ELAPSED => self.reply_subcommand(subcmd, 0x83, &[0u8; 14]),
+            SUBCMD_SPI_READ => {
+                if args.len() < 5 {
+                    self.reply_subcommand(subcmd, 0x80, &[]);
+                    return;
+                }
+                let addr = u32::from_le_bytes([args[0], args[1], args[2], args[3]]);
+                let len = (args[4] as usize).min(SPI_READ_MAX);
+                let mut reply = args[0..4].to_vec();
+                reply.push(len as u8);
+                for offset in 0..len as u32 {
+                    let at = addr.wrapping_add(offset);
+                    let byte = self.spi_writes.get(&at).copied().unwrap_or(spi_flash_byte(at));
+                    reply.push(byte);
+                }
+                self.reply_subcommand(subcmd, 0x90, &reply);
+            }
+            SUBCMD_SPI_WRITE => {
+                // address (4 LE), length, data: kept in memory only
+                if args.len() >= 5 {
+                    let addr = u32::from_le_bytes([args[0], args[1], args[2], args[3]]);
+                    let len = (args[4] as usize).min(args.len() - 5);
+                    for (offset, byte) in args[5..5 + len].iter().enumerate() {
+                        self.spi_writes.insert(addr.wrapping_add(offset as u32), *byte);
+                    }
+                }
+                self.reply_subcommand(subcmd, 0x80, &[0x00]);
+            }
+            SUBCMD_SPI_ERASE => {
+                if args.len() >= 4 {
+                    let addr = u32::from_le_bytes([args[0], args[1], args[2], args[3]]);
+                    let sector = addr & !0xfff;
+                    self.spi_writes.retain(|at, _| at & !0xfff != sector);
+                }
+                self.reply_subcommand(subcmd, 0x80, &[0x00]);
+            }
+            SUBCMD_SET_PLAYER_LIGHTS => {
+                self.player_lights = args.first().copied().unwrap_or(0);
+                self.reply_subcommand(subcmd, 0x80, &[]);
+            }
+            SUBCMD_GET_PLAYER_LIGHTS => {
+                let lights = [self.player_lights];
+                self.reply_subcommand(subcmd, 0xb1, &lights);
+            }
+            SUBCMD_ENABLE_IMU => {
+                self.imu_enabled = args.first().is_some_and(|on| *on != 0);
+                self.reply_subcommand(subcmd, 0x80, &[]);
+            }
+            SUBCMD_GET_REGULATED_VOLTAGE => self.reply_subcommand(subcmd, 0xd0, &[0x83, 0x06]),
+            // Home light, vibration on/off, IMU sensitivity, low power,
+            // NFC/IR MCU: acknowledge and carry on
+            _ => self.reply_subcommand(subcmd, 0x80, &[]),
+        }
+    }
+
+    /// Turn the rumble bytes (2-9: left then right actuator) of an output
+    /// report into a rumble event when they change. Both actuators carry the
+    /// same two bands from SDL and Steam: low band = strong, high = weak.
+    fn handle_rumble(&mut self, data: &[u8]) -> Vec<OutputEvent> {
+        if data.len() < 10 {
+            return vec![];
+        }
+        let (left_high, left_low) = decode_rumble(&data[2..6]);
+        let (right_high, right_low) = decode_rumble(&data[6..10]);
+        let to_magnitude = |index: u16| -> u16 {
+            let permille = rumble_amplitude_permille(index).min(1000.0);
+            (permille / 1000.0 * u16::MAX as f64).round() as u16
+        };
+        let weak = to_magnitude(left_high.max(right_high));
+        let strong = to_magnitude(left_low.max(right_low));
+        if (weak, strong) == self.rumble {
+            return vec![];
+        }
+        self.rumble = (weak, strong);
+        log::trace!("Switch Pro rumble: weak={weak} strong={strong}");
+        vec![OutputEvent::GenericRumble {
+            weak_magnitude: weak,
+            strong_magnitude: strong,
+        }]
+    }
+
+    /// Handle an output report from a host.
+    fn handle_output(&mut self, data: &[u8]) -> Vec<OutputEvent> {
+        let Some(&id) = data.first() else {
+            return vec![];
+        };
+        match id {
+            OUTPUT_USB_CMD => {
+                self.handle_usb_command(data);
+                vec![]
+            }
+            OUTPUT_RUMBLE_AND_SUBCMD => {
+                let events = self.handle_rumble(data);
+                self.handle_subcommand(data);
+                events
+            }
+            OUTPUT_RUMBLE_ONLY => self.handle_rumble(data),
+            _ => {
+                log::debug!("Unhandled Switch Pro output report 0x{id:02x}");
+                vec![]
+            }
+        }
+    }
+
+    /// Update the internal controller state when events are emitted.
+    fn update_state(&mut self, event: NativeEvent) {
+        let value = event.get_value();
+        let capability = event.as_capability();
+        match capability {
+            Capability::Gamepad(gamepad) => match gamepad {
+                Gamepad::Button(btn) => {
+                    let pressed = event.pressed();
+                    match btn {
+                        GamepadButton::South => self.state.a = pressed,
+                        GamepadButton::East => self.state.b = pressed,
+                        GamepadButton::West => self.state.x = pressed,
+                        GamepadButton::North => self.state.y = pressed,
+                        GamepadButton::Start => self.state.plus = pressed,
+                        GamepadButton::Select => self.state.minus = pressed,
+                        GamepadButton::Guide => self.state.home = pressed,
+                        GamepadButton::Screenshot => self.state.capture = pressed,
+                        GamepadButton::DPadUp => self.state.up = pressed,
+                        GamepadButton::DPadDown => self.state.down = pressed,
+                        GamepadButton::DPadLeft => self.state.left = pressed,
+                        GamepadButton::DPadRight => self.state.right = pressed,
+                        GamepadButton::LeftBumper => self.state.l = pressed,
+                        GamepadButton::RightBumper => self.state.r = pressed,
+                        GamepadButton::LeftTrigger => self.state.zl_button = pressed,
+                        GamepadButton::RightTrigger => self.state.zr_button = pressed,
+                        GamepadButton::LeftStick => self.state.l_stick = pressed,
+                        GamepadButton::RightStick => self.state.r_stick = pressed,
+                        _ => (),
+                    }
+                }
+                Gamepad::Axis(axis) => match axis {
+                    GamepadAxis::LeftStick => {
+                        if let InputValue::Vector2 { x, y } = value {
+                            if let Some(x) = x {
+                                self.state.left_stick.0 = stick_value(x);
+                            }
+                            if let Some(y) = y {
+                                // InputPlumber's Y grows downwards, the Pro's upwards
+                                self.state.left_stick.1 = stick_value(-y);
+                            }
+                        }
+                    }
+                    GamepadAxis::RightStick => {
+                        if let InputValue::Vector2 { x, y } = value {
+                            if let Some(x) = x {
+                                self.state.right_stick.0 = stick_value(x);
+                            }
+                            if let Some(y) = y {
+                                self.state.right_stick.1 = stick_value(-y);
+                            }
+                        }
+                    }
+                    GamepadAxis::Hat0 => {
+                        if let InputValue::Vector2 { x, y } = value {
+                            if let Some(x) = x {
+                                self.state.left = x < -0.5;
+                                self.state.right = x > 0.5;
+                            }
+                            if let Some(y) = y {
+                                self.state.up = y < -0.5;
+                                self.state.down = y > 0.5;
+                            }
+                        }
+                    }
+                    _ => (),
+                },
+                Gamepad::Trigger(trigger) => match trigger {
+                    GamepadTrigger::LeftTrigger => {
+                        if let InputValue::Float(v) = value {
+                            self.state.zl_analog = trigger_pressed(self.state.zl_analog, v);
+                        }
+                    }
+                    GamepadTrigger::RightTrigger => {
+                        if let InputValue::Float(v) = value {
+                            self.state.zr_analog = trigger_pressed(self.state.zr_analog, v);
+                        }
+                    }
+                    _ => (),
+                },
+                Gamepad::Accelerometer => {
+                    if let InputValue::Vector3 { x, y, z } = value {
+                        for (i, v) in [x, y, z].into_iter().enumerate() {
+                            if let Some(v) = v {
+                                self.state.accel[i] = clamp_i16(v / 9.80665 * ACCEL_1G);
+                            }
+                        }
+                    }
+                }
+                Gamepad::Gyro => {
+                    if let InputValue::Vector3 { x, y, z } = value {
+                        for (i, v) in [x, y, z].into_iter().enumerate() {
+                            if let Some(v) = v {
+                                self.state.gyro[i] = clamp_i16(v * GYRO_PER_DPS);
+                            }
+                        }
+                    }
+                }
+                _ => (),
+            },
+            _ => (),
+        };
+    }
+}
+
+impl TargetInputDevice for SwitchProDevice {
+    fn write_event(&mut self, event: NativeEvent) -> Result<(), InputError> {
+        log::trace!("Received event: {event:?}");
+
+        // A Pro Controller has no Quick Access button: send Steam's own
+        // chord for it, Guide + A.
+        // TODO: Remove once we implement target device profiles
+        if event.as_capability() == Capability::Gamepad(Gamepad::Button(GamepadButton::QuickAccess))
+        {
+            let pressed = event.pressed();
+            let guide = NativeEvent::new(
+                Capability::Gamepad(Gamepad::Button(GamepadButton::Guide)),
+                event.get_value(),
+            );
+            let south = NativeEvent::new(
+                Capability::Gamepad(Gamepad::Button(GamepadButton::South)),
+                event.get_value(),
+            );
+            let (guide, south) = if pressed {
+                let guide = ScheduledNativeEvent::new(guide, Duration::from_millis(0));
+                let south = ScheduledNativeEvent::new(south, MIN_CHORD_TIME);
+                (guide, south)
+            } else {
+                let guide = ScheduledNativeEvent::new(guide, MIN_CHORD_TIME * 3);
+                let south = ScheduledNativeEvent::new(south, MIN_CHORD_TIME * 2);
+                (guide, south)
+            };
+            self.queued_events.push(guide);
+            self.queued_events.push(south);
+            return Ok(());
+        }
+
+        self.update_state(event);
+        Ok(())
+    }
