# Our kernel options on top of pb-os's steamos.config (merged by build.sh as steamos-sm8550.config).
# ff6 (2026-10-25): userfaultfd, so Proton's write watches can use the kernel's
# async write-protect tracking instead of mprotect + one SIGSEGV per page (off in ROCKNIX's SM8550 config,
# pb-os's golden.config and Armada's; Arch's kernel has it on). arm64 selects HAVE_ARCH_USERFAULTFD_WP with it.
CONFIG_USERFAULTFD=y
